[sub_resource type="GDScript" id="GDScript_erxwv"]
script/source = "extends Camera3D

@export var speed: float = 20.0
@export var min_speed: float = 1.0
@export var max_speed: float = 200.0
@export var sprint_multiplier: float = 5.0
@export var mouse_sensitivity: float = 0.003

var yaw: float = 0.0
var pitch: float = 0.0

func _ready() -> void:
	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)

func _input(event: InputEvent) -> void:
	if event.is_action_pressed(&\"ui_cancel\"):
		if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
			Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
		else:
			Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
		return
	
	if Input.get_mouse_mode() != Input.MOUSE_MODE_CAPTURED:
		return
	
	if event is InputEventMouseMotion:
		yaw -= event.relative.x * mouse_sensitivity
		pitch -= event.relative.y * mouse_sensitivity
		pitch = clamp(pitch, -PI / 2 + 0.001, PI / 2 - 0.001)
	
	if event is InputEventMouseButton:
		var multiplier: float = 1.0
		match event.button_index:
			MOUSE_BUTTON_WHEEL_UP:
				multiplier = 1.1
			MOUSE_BUTTON_WHEEL_DOWN:
				multiplier = 1.0 / 1.1
		if multiplier != 1.0:
			speed = clamp(speed * multiplier, min_speed, max_speed)

func _physics_process(delta: float) -> void:
	if Input.get_mouse_mode() != Input.MOUSE_MODE_CAPTURED:
		return
	
	# Apply rotation
	rotation.y = yaw
	rotation.x = pitch
	
	# Raw WASD input (camera-relative horizontal)
	var input_dir := Vector3.ZERO
	var forward := -transform.basis.z
	var right := transform.basis.x
	
	if Input.is_key_pressed(KEY_W):
		input_dir += forward
	if Input.is_key_pressed(KEY_S):
		input_dir -= forward
	if Input.is_key_pressed(KEY_A):
		input_dir -= right
	if Input.is_key_pressed(KEY_D):
		input_dir += right
	
	input_dir = input_dir.normalized()
	
	# Raw vertical input (world-relative)
	var v_input := float(Input.is_key_pressed(KEY_SPACE)) - float(Input.is_key_pressed(KEY_CTRL))
	
	# Combined direction
	var direction := Vector3(input_dir.x, v_input, input_dir.z).normalized()
	
	# Speed with sprint
	var current_speed := speed
	if Input.is_key_pressed(KEY_SHIFT):
		current_speed *= sprint_multiplier
	
	# Move
	position += direction * current_speed * delta
"

