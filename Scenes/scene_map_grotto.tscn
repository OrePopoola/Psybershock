[sub_resource type="GDScript" id="GDScript_e0g62"]
script/source = "extends GridMap

const FloorScene = preload(\"res://3D/Tiles/floor_tile.tscn\")
@export var jitter_amount: float = 0.0003     # tune this — start small (0.0003–0.001)
@export var y_lift: float = 0.0004            # small upward bias to break perfect plane overlap

func _ready() -> void:
	var floor_cells = get_cells_with_item(0)           # ← renamed
	replace_tiles_with_scenes(floor_cells, FloorScene)


# Renamed to avoid conflict with built-in get_used_cells_by_item()
func get_cells_with_item(item_id: int) -> Array[Vector3i]:
	var result: Array[Vector3i] = []
	for cell in get_used_cells():
		if get_cell_item(cell) == item_id:
			result.append(cell)
	return result


func replace_tiles_with_scenes(cells: Array[Vector3i], scene: PackedScene) -> void:
	for cell in cells:
		set_cell_item(cell, -1)
		
		var instance = scene.instantiate()
		
		var base_pos = map_to_local(cell)
		
		# True random offset — different every run
		var offset_x = randf_range(-jitter_amount, jitter_amount)
		var offset_z = randf_range(-jitter_amount, jitter_amount)
		var offset_y = y_lift + randf_range(-jitter_amount * 0.5, jitter_amount * 0.5)  # smaller Y variation
		
		instance.position = base_pos + Vector3(offset_x, offset_y, offset_z)
		
		add_child(instance)
"

